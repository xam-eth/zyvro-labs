# Zernio connection secrets — NEVER commit real values, never paste them in chat.
# Copy to mcp/zernio/.env (gitignored) on the machine that runs the client,
# or set them in your MCP client / Vercel environment instead.

# Bearer key from https://zernio.com/dashboard/api-keys (headless setups),
# or leave empty and let the client do the OAuth 2.1 PKCE browser sign-in.
ZERNIO_API_KEY=

# Channel ids as shown in your Zernio dashboard after connecting the three
# accounts (LinkedIn owner, X owner, X Zyvro Labs). Fill these in ONLY on the
# machine that publishes; the repo keeps account handles withheld.
ZERNIO_CHANNEL_LINKEDIN_OWNER=
ZERNIO_CHANNEL_X_OWNER=
ZERNIO_CHANNEL_X_ZYVROLABS=
